<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net472;netstandard2.1;net8.0;net10.0;net11.0</TargetFrameworks>

        <Product>DryIocAttributes</Product>
        <VersionPrefix>8.0.0</VersionPrefix>
        <VersionSuffix></VersionSuffix>

        <AssemblyName>$(Product)</AssemblyName>
        <AssemblyTitle>$(AssemblyName) $(TargetFramework)</AssemblyTitle>

        <PackageId>$(Product).dll</PackageId>
        <Title>$(Product).dll</Title>
        <Description>Superset of MEF attributes. In addition to Export/Import contains attributes to support modern IOC (DryIoc) features</Description>
        <PackageTags>MEF Attributes Attributed-Model Composition IoC Container Inversion-of-Control DI Dependency-Injection DRY Service-Provider Factory</PackageTags>
        <PackageReleaseNotes>
            <![CDATA[
## v8.0.0 Major feature release

### Bird view

- 10, 11 is now supported, interim .net versions dropped, keep supporting net472 and netstandard2.1
- Depending on DryIoc v6 and all its goodies
- Better performance and less memory allocations

### Features

### Fixes

- #663 DryIocAttributes and DryIoc.MefAttributedModel are not nullable friendly

        ]]>
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.ComponentModel.Composition" Version="5.0.0" />
    </ItemGroup>
</Project>
