<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(LatestSupportedNet)' == 'net9.0'">net45;netstandard2.0;netstandard2.1;net6.0;net8.0;net9.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(LatestSupportedNet)' == 'net8.0'">net45;netstandard2.0;netstandard2.1;net6.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(LatestSupportedNet)' == 'net7.0'">net45;netstandard2.0;netstandard2.1;net6.0;net7.0</TargetFrameworks>

    <Product>DryIoc</Product>

    <VersionPrefix>6.0.0</VersionPrefix>
    <VersionSuffix>preview-09</VersionSuffix>

    <AssemblyName>$(Product)</AssemblyName>
    <AssemblyTitle>$(AssemblyName) $(TargetFramework)</AssemblyTitle>

    <PackageId>$(Product).dll</PackageId>
    <Title>$(Product).dll</Title>

    <PackageReadmeFile>readme.md</PackageReadmeFile>

    <Description>DryIoc is fast, small, full-featured IoC Container for .NET</Description>
    <PackageTags>IoC Container Inversion-of-Control DI Dependency-Injection DRY Service-Provider Factory FastExpressionCompiler ImTools</PackageTags>
    <PackageReleaseNotes>
      <![CDATA[
## v6.0.0 Major feature release

- Decrease memory footprint
- Remove Obsolete API
- @WIP Compile-time Dependency Injection

]]>
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Label="Packaging build and content files">
    <None Include="..\..\nuspecs\DryIoc\readme.md" Pack="true" PackagePath="\"/>
    <None Include="..\..\nuspecs\DryIoc\build\DryIoc.dll.targets" Pack="true" PackagePath="build" />
    <None Include=".config\dotnet-tools.json" Pack="true" PackagePath="tools" />
    <None Include="CompileTimeDI\**\*" Pack="true" PackagePath="CompileTimeDI" />
    <!-- Exclude CompileTimeDI content files from DryIoc.dll compilation:
         These files are copied to consumer projects and should not be part of the DryIoc.dll assembly.
         Including them would create duplicate type definitions (CS0436) in consumer projects. -->
    <Compile Remove="CompileTimeDI\*.cs" />
  </ItemGroup>

  <!-- Skip T4 re-generation in this project: Example types are not in DryIoc.dll (see above),
       so the T4 template cannot find them. Consumers regenerate using their own assembly. -->
  <PropertyGroup>
    <SkipCompTimeGen>true</SkipCompTimeGen>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>

  <Target Name="BeforeCompile">
    <Message Importance="high" Text="MSBuildNodeCount: $(MSBuildNodeCount)"/>
  </Target>

  <!-- Run compile-time generation only in debug configuration,
      for the one of target frameworks (highest),
      when DryIoc was already built (TargetPath exists) in order to consume its types via dotnet-t4 -->
  <Target Name="CompileTimeGenerate" BeforeTargets="PrepareForBuild" Condition="('$(TargetFramework)' == 'net9.0' OR '$(TargetFramework)' == 'net8.0') AND '$(SkipCompTimeGen)' != 'true' AND '$(Configuration)' == 'Debug' AND Exists('$(ProjectDir)CompileTimeDI') AND Exists('$(TargetPath)')">

    <Message Text="[DryIoc] Generating compile-time container for $(TargetFramework)..." Importance="high"/>

    <Exec WorkingDirectory="$(ProjectDir)"
          Command="dotnet tool restore --ignore-failed-sources"
          IgnoreExitCode="true" />
    <Exec WorkingDirectory="$(ProjectDir)"
          Command="dotnet t4 -P=&quot;$(TargetDir)&quot; -r=&quot;$(TargetPath)&quot; -o=CompileTimeDI/Container.Generated.cs CompileTimeDI/Container.Generated.tt" />
    <Message Text="[DryIoc] Generated: '$(ProjectDir)CompileTimeDI/Container.Generated.cs'" Importance="high"/>
  </Target>

  <ItemGroup>
    <None Update="CompileTimeDI\Container.Generated.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>CompileTimeDI\Container.Generated.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="CompileTimeDI\Container.Generated.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CompileTimeDI\Container.Generated.tt</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
