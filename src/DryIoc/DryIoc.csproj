<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.1;net8.0;net10.0;net11.0</TargetFrameworks>

    <Product>DryIoc</Product>

    <VersionPrefix>6.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>

    <AssemblyName>$(Product)</AssemblyName>
    <AssemblyTitle>$(AssemblyName) $(TargetFramework)</AssemblyTitle>

    <PackageId>$(Product).dll</PackageId>
    <Title>$(Product).dll</Title>

    <PackageReadmeFile>readme.md</PackageReadmeFile>

    <Description>DryIoc is fast, small, full-featured IoC Container for .NET</Description>
    <PackageTags>IoC Container Inversion-of-Control DI Dependency-Injection DRY Service-Provider Factory FastExpressionCompiler ImTools</PackageTags>
    <PackageReleaseNotes>
      <![CDATA[
## v6.0.0 Major feature release

### Bird view

- 10, 11 is now supported, interim .net versions dropped and net45 -> net472, netstandard2.0 -> netstandard2.1
- Decrease memory footprint without speed regression
- Remove Obsolete API (small things in more customizable parts of Container)
- Compile-time Dependency Injection (T4-based, AOT-friendly; see `readme.md` in the DryIoc.dll NuGet package)
- #492 Remove obsolete WithAutoFallbackResolution

### Features

- #695 Improve DryIoc.dll NuGet package CompileTime DI install/update experience
- #679 Add DryIoc own all-encompassing RegisterAttribute
- #676 Add the Settings.ThrowOnRegisteringDisposableTransient on the registration level to override the global setting
- #660 Populate on IRegistrator
- #638 Add the global test option to run all tests with WithoutUseInterpretation option
- #636 [question/feature request] keyed services in delegate resolution
- #632 MS DI AddKeyed... variant registration fails
- #618 Multiple same service key support mostly for DryIoc.MS.DI though it is already supported in DryIoc.MefAttributedModel
- #612 For the conditional singleton or the singleton registered with AnyKey - should we create a new singleton per condition or the resolution key?
- #512 Optimize injection of IResolverContext
- #504 Probably add the IDictionary<TServiceKey, TService> wrapper
- #503 [CompTimeDI] Replace partial methods with more flexible interface ICompileTimeContainer
- #495 [CompTimeDI] Automatically generate Resolution calls for the missing registrations to avoid manual RegisterPlaceholder
- #485 Add Rules to IResolverContext interface
- #480 Change Request.Container property to field and change its type from IContainer to Container
- #223 IAsyncDisposable is not being called after container.Dispose
- #212 Improve source package with T4 install experience

### Fixes

- #708 Missed parent parameter in IContainer.With overload
- #694 Singleton service resolved by scoped container, not root container
- #692 Resolve failed on Android(Avalonia)
- #690 DryIoc is not working together with Blazor InputFile component
- #685 Creating scopes via funcs is not thread-safe and fails sporadically with NullRef exception
- #672 Wrong decorator parameter with custom args
- #653 KeyValuePair exposes internal DryIoc structures
- #651 Resolving func-wrapper when having circular-dependency throws RecursiveDependencyDetected
- #648 [BUG] Resolve<> crashes with the misleading, casting-related Exception when class is also registered using RegisterInitializer
- #646 Resolve enforces passed arguments to be used (and fails because of it)
- #643 WithConcreteTypeDynamicRegistrations results in unintended instantiation
- #642 System.NullReferenceException: Object reference not set to an instance of an object
- #631 Conditional registrations
- #625 FactoryType is not forwarded in the RegisterMapping<TService, TRegisteredService> method
- #624 Consistent behavior of a faulty singleton
- #623 Scoped service decorator
- #610 ConstructorWithResolvableArguments conflicts with dynamic registrations
- #580 Scope is lost in IResolver inside scope because of singleton
- #535 Property injection is not working correctly when appending a new implementation for multiple registrations of the same interface and injecting an enumerable of the interface.
- #552 Compatibility with Android/iOS AOT compilation
- #532 [Xamarin.iOS] DryIocTypeResolver.Resolve (System.Type type) SIGABRT: Operation is not supported on this platform.

]]>
    </PackageReleaseNotes>
  </PropertyGroup>

  <!-- todo: @feat comp-time in .net 10: adopt C# 14 interceptors / .NET 10 source-gen APIs for zero-reflection DI without T4 -->
  <!-- todo: @feat AOT publish: verify full NativeAOT compatibility of DryIoc.dll + MSDI adapter -->

  <ItemGroup Label="Packaging build and content files">
    <None Include="..\..\nuspecs\DryIoc\readme.md" Pack="true" PackagePath="\"/>
    <None Include="..\..\nuspecs\DryIoc\build\DryIoc.dll.targets" Pack="true" PackagePath="build" />
    <None Include=".config\dotnet-tools.json" Pack="true" PackagePath="tools" />
    <None Include="CompileTimeDI\**\*" Pack="true" PackagePath="CompileTimeDI" />
    <!-- Exclude CompileTimeDI content files from DryIoc.dll compilation:
         These files are copied to consumer projects and should not be part of the DryIoc.dll assembly.
         Including them would create duplicate type definitions (CS0436) in consumer projects. -->
    <Compile Remove="CompileTimeDI\*.cs" />
  </ItemGroup>

  <!-- Skip T4 re-generation in this project: Example types are not in DryIoc.dll (see above),
       so the T4 template cannot find them. Consumers regenerate using their own assembly. -->
  <PropertyGroup>
    <SkipCompTimeGen>true</SkipCompTimeGen>
  </PropertyGroup>

  <Target Name="BeforeCompile">
    <Message Importance="high" Text="MSBuildNodeCount: $(MSBuildNodeCount)"/>
  </Target>

  <!-- Run compile-time generation only in debug configuration,
      for the one of target frameworks (highest),
      when DryIoc was already built (TargetPath exists) in order to consume its types via dotnet-t4 -->
  <Target Name="CompileTimeGenerate" BeforeTargets="PrepareForBuild" Condition="('$(TargetFramework)' == 'net10.0' OR '$(TargetFramework)' == 'net8.0') AND '$(SkipCompTimeGen)' != 'true' AND '$(Configuration)' == 'Debug' AND Exists('$(ProjectDir)CompileTimeDI') AND Exists('$(TargetPath)')">

    <Message Text="[DryIoc] Generating compile-time container for $(TargetFramework)..." Importance="high"/>

    <Exec WorkingDirectory="$(ProjectDir)"
          Command="dotnet tool restore --ignore-failed-sources"
          IgnoreExitCode="true" />
    <Exec WorkingDirectory="$(ProjectDir)"
          Command="dotnet t4 -P=&quot;$(TargetDir)&quot; -r=&quot;$(TargetPath)&quot; -o=CompileTimeDI/Container.Generated.cs CompileTimeDI/Container.Generated.tt" />
    <Message Text="[DryIoc] Generated: '$(ProjectDir)CompileTimeDI/Container.Generated.cs'" Importance="high"/>
  </Target>

  <ItemGroup>
    <None Update="CompileTimeDI\Container.Generated.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>CompileTimeDI\Container.Generated.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="CompileTimeDI\Container.Generated.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CompileTimeDI\Container.Generated.tt</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
