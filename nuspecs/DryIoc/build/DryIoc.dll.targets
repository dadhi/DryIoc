<Project>
    <!--
        DryIoc Compile-Time DI - MSBuild Targets
        
        This file automates the DryIoc compile-time DI setup:
        1. CopyCompileTimeDIToProject: Copies T4 templates and example files to the consuming project on first install/update.
           - Always updates: Container.Generated.tt, CompileTimeRegistrations.Example.cs (safe to update)
           - First-install only: CompileTimeRegistrations.ttinclude, Container.Generated.cs (preserve user customizations)
           - First-install only: .config/dotnet-tools.json (preserve user-added tools)
        2. CompileTimeGenerate: Runs dotnet-t4 to (re-)generate Container.Generated.cs from the T4 template.
           - Runs only in Debug configuration to avoid slowing down Release builds.
           - Set $(SkipCompTimeGen)=true in your project to disable generation entirely.
    -->

    <Target Name="CopyCompileTimeDIToProject" BeforeTargets="Build">
        <Message Text="[DryIoc] Setting up Compile-Time DI files..." Importance="high" />

        <!-- Ensure CompileTimeDI folder exists -->
        <MakeDir Directories="$(ProjectDir)CompileTimeDI" Condition="!Exists('$(ProjectDir)CompileTimeDI')" />

        <!-- Always update the T4 template (safe to overwrite - auto-generated, no user customizations) -->
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\CompileTimeDI\Container.Generated.tt"
              DestinationFolder="$(ProjectDir)CompileTimeDI"
              SkipUnchangedFiles="true" />

        <!-- Always update the example file (safe to overwrite - shows current API) -->
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\CompileTimeDI\CompileTimeRegistrations.Example.cs"
              DestinationFolder="$(ProjectDir)CompileTimeDI"
              SkipUnchangedFiles="true" />

        <!-- Only copy on first install - user customizes this file with their own registrations -->
        <Copy Condition="!Exists('$(ProjectDir)CompileTimeDI\CompileTimeRegistrations.ttinclude')"
              SourceFiles="$(MSBuildThisFileDirectory)..\CompileTimeDI\CompileTimeRegistrations.ttinclude"
              DestinationFolder="$(ProjectDir)CompileTimeDI" />

        <!-- Only copy on first install - will be regenerated by T4 on subsequent builds -->
        <Copy Condition="!Exists('$(ProjectDir)CompileTimeDI\Container.Generated.cs')"
              SourceFiles="$(MSBuildThisFileDirectory)..\CompileTimeDI\Container.Generated.cs"
              DestinationFolder="$(ProjectDir)CompileTimeDI" />

        <!-- Ensure .config folder exists for the dotnet-tools manifest -->
        <MakeDir Directories="$(ProjectDir).config" Condition="!Exists('$(ProjectDir).config')" />

        <!-- Only copy on first install - preserve user-added tools in their manifest -->
        <Copy Condition="!Exists('$(ProjectDir).config\dotnet-tools.json')"
              SourceFiles="$(MSBuildThisFileDirectory)..\tools\dotnet-tools.json"
              DestinationFolder="$(ProjectDir).config" />

        <!-- Restore dotnet-t4 tool (uses the manifest in .config/dotnet-tools.json) -->
        <Exec WorkingDirectory="$(ProjectDir)"
              Command="dotnet tool restore --ignore-failed-sources"
              IgnoreExitCode="true" />

        <Message Text="[DryIoc] Compile-Time DI setup complete. Edit 'CompileTimeDI\CompileTimeRegistrations.ttinclude' with your registrations." Importance="high" />
    </Target>

    <!--
        Runs dotnet-t4 to regenerate Container.Generated.cs from Container.Generated.tt.
        Conditions:
          - SkipCompTimeGen != true    (opt-out property)
          - Debug configuration only   (avoid slowing Release builds)
          - CompileTimeDI folder exists (setup has been done)
          - TargetPath exists           (project was built at least once so the assembly is available for T4)
          - Only for modern TFMs that fully support dotnet-t4
    -->
    <Target Name="CompileTimeGenerate"
        BeforeTargets="PrepareForBuild"
        Condition="'$(SkipCompTimeGen)' != 'true' AND '$(Configuration)' == 'Debug' AND Exists('$(ProjectDir)CompileTimeDI') AND Exists('$(TargetPath)') AND ('$(TargetFramework)' == 'netstandard2.1' OR '$(TargetFramework)' == 'net6.0' OR '$(TargetFramework)' == 'net7.0' OR '$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0' OR '$(TargetFramework)' == 'net10.0')">

        <Message Text="[DryIoc] Generating compile-time container for $(TargetFramework)..." Importance="high"/>

        <Exec WorkingDirectory="$(ProjectDir)"
              Command="dotnet tool restore --ignore-failed-sources"
              IgnoreExitCode="true" />

        <Exec WorkingDirectory="$(ProjectDir)"
              Command="dotnet t4 -P=&quot;$(TargetDir)&quot; -r=&quot;$(TargetPath)&quot; -o=CompileTimeDI\Container.Generated.cs CompileTimeDI\Container.Generated.tt" />

        <Message Text="[DryIoc] Generated: '$(ProjectDir)CompileTimeDI\Container.Generated.cs'" Importance="high"/>
    </Target>

    <ItemGroup>
      <None Update="CompileTimeDI\Container.Generated.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>CompileTimeDI\Container.Generated.cs</LastGenOutput>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="CompileTimeDI\Container.Generated.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>CompileTimeDI\Container.Generated.tt</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>