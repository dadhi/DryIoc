<Project>
    <!-- CopyCompileTimeDIToProject: copies T4 files to the consuming project on install/update.
         - Always refreshes package-owned files (Container.Generated.tt, CompileTimeRegistrations.Example.cs).
         - First-install-only: user-owned files (CompileTimeRegistrations.ttinclude, Container.Generated.cs,
           .config/dotnet-tools.json) are never overwritten so user customizations are preserved.
    -->
    <Target Name="CopyCompileTimeDIToProject" BeforeTargets="Build">
        <!-- Always refresh package-owned files -->
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\CompileTimeDI\Container.Generated.tt"
              DestinationFolder="$(ProjectDir)CompileTimeDI" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\CompileTimeDI\CompileTimeRegistrations.Example.cs"
              DestinationFolder="$(ProjectDir)CompileTimeDI" SkipUnchangedFiles="true" />

        <!-- First-install only: user-owned files -->
        <Copy Condition="!Exists('$(ProjectDir)CompileTimeDI\CompileTimeRegistrations.ttinclude')"
              SourceFiles="$(MSBuildThisFileDirectory)..\CompileTimeDI\CompileTimeRegistrations.ttinclude"
              DestinationFolder="$(ProjectDir)CompileTimeDI" />
        <Copy Condition="!Exists('$(ProjectDir)CompileTimeDI\Container.Generated.cs')"
              SourceFiles="$(MSBuildThisFileDirectory)..\CompileTimeDI\Container.Generated.cs"
              DestinationFolder="$(ProjectDir)CompileTimeDI" />
        <Copy Condition="!Exists('$(ProjectDir).config\dotnet-tools.json')"
              SourceFiles="$(MSBuildThisFileDirectory)..\tools\dotnet-tools.json"
              DestinationFolder="$(ProjectDir).config" />

        <Exec WorkingDirectory="$(ProjectDir)"
              Command="dotnet tool restore --ignore-failed-sources"
              IgnoreExitCode="true" />
    </Target>

    <!-- CompileTimeGenerate: runs dotnet-t4 to regenerate Container.Generated.cs.
         Conditions: Debug only; CompileTimeDI setup done; assembly built at least once (TargetPath exists);
         supported TFMs only; opt-out via $(SkipCompTimeGen)=true.
    -->
    <Target Name="CompileTimeGenerate"
        BeforeTargets="PrepareForBuild"
        Condition="'$(SkipCompTimeGen)' != 'true' AND '$(Configuration)' == 'Debug'
                   AND Exists('$(ProjectDir)CompileTimeDI') AND Exists('$(TargetPath)')
                   AND ('$(TargetFramework)' == 'netstandard2.1'
                     OR '$(TargetFramework)' == 'net6.0' OR '$(TargetFramework)' == 'net7.0'
                     OR '$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0'
                     OR '$(TargetFramework)' == 'net10.0')">

        <Message Text="[DryIoc] Regenerating Container.Generated.cs for $(TargetFramework)..." Importance="high"/>
        <Exec WorkingDirectory="$(ProjectDir)"
              Command="dotnet tool restore --ignore-failed-sources"
              IgnoreExitCode="true" />
        <Exec WorkingDirectory="$(ProjectDir)"
              Command="dotnet t4 -P=&quot;$(TargetDir)&quot; -r=&quot;$(TargetPath)&quot; -o=CompileTimeDI/Container.Generated.cs CompileTimeDI/Container.Generated.tt" />
    </Target>

    <ItemGroup>
      <None Update="CompileTimeDI\Container.Generated.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>CompileTimeDI\Container.Generated.cs</LastGenOutput>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="CompileTimeDI\Container.Generated.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>CompileTimeDI\Container.Generated.tt</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>