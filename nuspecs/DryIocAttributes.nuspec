<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata minClientVersion="3.3.0">
    <id>DryIocAttributes</id>
    <version>8.0.0</version>
    <authors>Maksim Volkau</authors>
    <copyright>Copyright © 2013-2026 Maksim Volkau</copyright>
    <projectUrl>https://github.com/dadhi/DryIoc</projectUrl>
    <license type="expression">MIT</license>
    <icon>logo.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Super-set of MEF attributes. In addition to Export/Import contains attributes to support modern IOC (DryIoc) features.</description>
    <tags>MEF Attributes Attributed-Model Composition IoC Container Inversion-of-Control DI Dependency-Injection DRY Service-Provider Factory</tags>
    <releaseNotes>
    <![CDATA[
## v8.0.0 Major feature release

### Bird view

- 10, 11 is now supported, interim .net versions dropped, keep supporting net472 and netstandard2.1
- Depending on DryIoc v6 and all its goodies
- Better performance and less memory allocations

### Fixes

- #663 DryIocAttributes and DryIoc.MefAttributedModel are not nullable friendly

    ]]></releaseNotes>
    <contentFiles>
      <files include="cs/**/*.*" buildAction="Compile" />
    </contentFiles>
      <dependencies>
          <group targetFramework="net472">
              <dependency id="System.ComponentModel.Composition" version="4.7.0" exclude="Build,Analyzers" />
          </group>
          <group targetFramework="netstandard2.1">
              <dependency id="System.ComponentModel.Composition" version="4.7.0" exclude="Build,Analyzers" />
          </group>
      </dependencies>
  </metadata>
  <files>
    <file src="..\LICENSE.txt" />
    <file src="..\nuspecs\DryIoc.snk" />
    <file src="..\logo\logo128.png" target="logo.png" />

    <file src="_._" target="lib\net472\" />
    <file src="_._" target="lib\netstandard2.1\" />

    <!-- net472 -->
    <file src="..\src\DryIocAttributes\Attributes.cs" target="content\net472\DryIocAttributes" />

    <!-- NetStandard2.1 (based on Net45) -->
    <file src="..\src\DryIocAttributes\Attributes.cs"   target="contentFiles\cs\netstandard2.1\DryIocAttributes" />

  </files>
</package>
