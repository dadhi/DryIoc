<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--Use local packages first (the locally packed DryIoc.dll), then fallback to nuget.org-->
    <clear />
    <add key="local-packages" value="../../.dist/packages" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
